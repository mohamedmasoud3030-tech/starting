          </p>
          <p className="sm:col-span-2">
            <span className="text-slate-500">الوقت</span> <b>{view.schedule}</b>
          </p>
          <p className="sm:col-span-2">
            <span className="text-slate-500">الموقع</span>{" "}
            <b>
              {view.venue} {view.address}
            </b>
          </p>
        </div>
        <table className="mt-5 w-full text-right text-sm">
          <thead>
            <tr className="border-b text-slate-500">
              <th className="py-2 font-bold">البند</th>
              <th className="py-2 font-bold">الكمية</th>
              <th className="py-2 font-bold">السعر</th>
              <th className="py-2 font-bold">الإجمالي</th>
            </tr>
          </thead>
          <tbody>
            {view.lines.map((l, i) => (
              <tr key={i} className="border-b border-slate-100">
                <td className="py-2 font-bold">{l.description}</td>
                <td className="py-2">{l.quantityLabel}</td>
                <td className="py-2">{formatOMR(l.unitPriceMilli)}</td>
                <td className="py-2 font-extrabold">{formatOMR(l.totalMilli)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p className="mt-4 text-left text-2xl font-extrabold">
          الإجمالي: {formatOMR(view.sellingTotalMilli)}
        </p>
        {view.notes ? <p className="mt-3 text-sm text-slate-600">{view.notes}</p> : null}
        <p className="mt-2 text-sm text-slate-500">{view.terms}</p>
      </div>
    </div>
  );
}

function TeamTab({ eventId }: { eventId: string }) {
  const { session } = useSession();
  const state = useEngine();
  const event = state.events.find((e) => e.id === eventId)!;
  const canAssign = canAssignStaffFor(session!.role);
  const canCost = canReadCostFor(session!.role);
  const assignments = state.staffAssignments.filter((a) => a.eventId === eventId);
  const staff = state.staffMembers.filter(
    (s) => s.organizationId === session!.organizationId,
  );
  const [staffId, setStaffId] = useState(staff.find((s) => s.isActive)?.id ?? "");
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);

  const windowStart = event.teamArrivalAt ?? event.startAt;
  const windowEnd = event.endAt;
  const selectedAvail = staffId
    ? getStaffAvailability(state, session!, staffId, windowStart, windowEnd)
    : null;

  return (
    <div className="space-y-4">
      {error ? <Alert>{error}</Alert> : null}
      {canAssign ? (
        <Card>
          <CardBody className="space-y-3">
            <Field label="إضافة موظف">
              <Select value={staffId} onChange={(e) => setStaffId(e.target.value)}>
                {staff.map((s) => {
                  const avail = getStaffAvailability(
                    state,
                    session!,
                    s.id,
                    windowStart,
                    windowEnd,
                  );
                  return (
                    <option key={s.id} value={s.id} disabled={!s.isActive}>
                      {s.name} — {STAFF_TYPE_LABELS[s.staffType]} —{" "}
                      {s.isActive
                        ? avail.available
                          ? "متاح"
                          : "غير متاح"
                        : "غير نشط"}
                    </option>
                  );
                })}
              </Select>
            </Field>
            {selectedAvail && !selectedAvail.available ? (
              <Alert tone="warning">
                غير متاح
                {selectedAvail.reason ? ` — ${selectedAvail.reason}` : ""}
                {selectedAvail.conflictingEventNumber
                  ? ` (${selectedAvail.conflictingEventNumber})`
                  : ""}
              </Alert>
            ) : selectedAvail?.available ? (
              <Alert tone="success">متاح في وقت هذه المناسبة</Alert>
            ) : null}
            <Button
              loading={busy}
              onClick={() => {
                setBusy(true);
                setError("");
                try {
                  assignEventStaff(session, { eventId, staffMemberId: staffId });
                } catch (e) {
                  setError(errorMessage(e));
                } finally {
                  setBusy(false);
                }
              }}
            >
              إسناد
            </Button>
          </CardBody>
        </Card>
      ) : null}

      {assignments.length === 0 ? (
        <p className="text-slate-500">لم يُسند أحد بعد.</p>
      ) : (
        assignments.map((a) => {
          const member = staff.find((s) => s.id === a.staffMemberId);
          return (
            <Card key={a.id}>
              <CardBody className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p className="text-lg font-extrabold">{member?.name}</p>
                  <p className="text-sm text-slate-500">
                    {STAFF_TYPE_LABELS[a.assignmentRole]} ·{" "}
                    {formatMuscatTime(a.scheduledStart)} – {formatMuscatTime(a.scheduledEnd)}
                  </p>
                  {canCost ? (
                    <p className="text-sm font-bold">
                      {formatOMR(a.expectedCompensationMilli)}
                    </p>
                  ) : null}
                  <Badge tone={a.status === "ASSIGNED" ? "success" : "neutral"}>
                    {a.status === "ASSIGNED" ? "مسند" : a.status === "RELEASED" ? "أُفرج" : "ملغى"}
                  </Badge>
                </div>
                {canAssign && a.status === "ASSIGNED" ? (
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => releaseStaffAssignment(session, a.id)}
                  >
                    إلغاء الإسناد
                  </Button>
                ) : null}
              </CardBody>
            </Card>
          );
        })
      )}
    </div>
  );
}

function EquipmentTab({ eventId }: { eventId: string }) {
  const { session } = useSession();
  const state = useEngine();
  const event = state.events.find((e) => e.id === eventId)!;
  const canReserve = canReserveEquipmentFor(session!.role);
  const items = state.catalogItems.filter(
    (i) =>
      i.organizationId === session!.organizationId &&
      i.itemType === "REUSABLE_EQUIPMENT",
  );
  const reservations = state.equipmentReservations.filter((r) => r.eventId === eventId);
  const [itemId, setItemId] = useState(items[0]?.id ?? "");
  const [qty, setQty] = useState("4");
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);

  const from = shiftMinutes(event.startAt, -60);
  const until = shiftMinutes(event.endAt, 60);
  const preview = itemId
    ? getEquipmentAvailability(
        state,
        session!,
        itemId,
        from,
        until,
        Number(qty) || 0,
      )
    : null;

  return (
    <div className="space-y-4">
      {error ? <Alert>{error}</Alert> : null}
      {canReserve ? (
        <Card>
          <CardBody className="space-y-3">
            <Field label="المعدة">
              <Select value={itemId} onChange={(e) => setItemId(e.target.value)}>
                {items.map((i) => (
                  <option key={i.id} value={i.id}>
                    {i.nameAr}
                  </option>
                ))}
              </Select>
            </Field>
            <Field label="الكمية المطلوبة">
              <Input value={qty} onChange={(e) => setQty(e.target.value)} />
            </Field>
            {preview ? (
              <div className="rounded-xl bg-slate-50 p-3 text-sm font-bold">
                <p>الإجمالي: {preview.totalQuantity}</p>
                <p>محجوز في نفس الوقت: {preview.alreadyReserved}</p>
                <p>المتاح: {preview.available}</p>
                {preview.shortage > 0 ? (
                  <p className="text-red-700">
                    ناقص {preview.shortage} — الكمية المتاحة {preview.available}{" "}
                    والمطلوب {preview.requested}
                  </p>
                ) : (
                  <p className="text-emerald-700">الكمية متاحة</p>
                )}
              </div>
            ) : null}
            <Button
              loading={busy}
              onClick={() => {
                setBusy(true);
                setError("");
                try {
                  reserveEventEquipment(session, {
                    eventId,
                    catalogItemId: itemId,
                    quantity: Number(qty),
                  });
                } catch (e) {
                  setError(errorMessage(e));
                } finally {
                  setBusy(false);
                }
              }}
            >
              حجز
            </Button>
          </CardBody>
        </Card>
      ) : null}

      {reservations.map((r) => {
        const item = items.find((i) => i.id === r.catalogItemId);
        return (
          <Card key={r.id}>
            <CardBody className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p className="text-lg font-extrabold">{item?.nameAr}</p>
                <p className="text-sm text-slate-500">
                  {r.quantity} قطعة · {formatMuscatRange(r.reservedFrom, r.reservedUntil)}
                </p>
                <Badge tone={r.status === "ACTIVE" ? "success" : "neutral"}>
                  {r.status === "ACTIVE" ? "محجوز" : "أُفرج"}
                </Badge>
              </div>
              {canReserve && r.status === "ACTIVE" ? (
                <Button
                  size="sm"
                  variant="outline"
                  onClick={() => releaseEquipmentReservation(session, r.id)}
                >
                  إفراج
                </Button>
              ) : null}
            </CardBody>
          </Card>
        );
      })}
    </div>
  );
}

function HistoryTab({ eventId }: { eventId: string }) {
  const { session } = useSession();
  const state = useEngine();
  const history = state.eventHistory
    .filter((h) => h.eventId === eventId)
    .sort((a, b) => b.createdAt.localeCompare(a.createdAt));
  const audit = state.auditEvents.filter(
    (a) =>
      a.organizationId === session!.organizationId &&
      (a.entityId === eventId ||
        state.quotations.some((q) => q.eventId === eventId && q.id === a.entityId)),
  );

  return (
    <div className="space-y-3">
      <h3 className="text-lg font-extrabold">انتقالات الحالة</h3>
      {history.map((h) => (
        <Card key={h.id}>
          <CardBody>
            <p className="font-extrabold">
              {h.fromStatus ? EVENT_STATUS_LABELS[h.fromStatus] : "—"} ←{" "}
              {EVENT_STATUS_LABELS[h.toStatus]}
            </p>
            <p className="text-sm text-slate-500">
              {formatMuscatDateTime(h.createdAt)}
              {h.reason ? ` · ${h.reason}` : ""}
            </p>
          </CardBody>
        </Card>
      ))}
      <h3 className="mt-6 text-lg font-extrabold">سجل العمليات</h3>
      {audit.map((a) => (
        <Card key={a.id}>
          <CardBody>
            <p className="font-bold">{a.action}</p>
            <p className="text-sm text-slate-500">
              {formatMuscatDateTime(a.createdAt)}
            </p>
          </CardBody>
        </Card>
      ))}
    </div>
  );
}
