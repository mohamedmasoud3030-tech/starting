      reason: `إصدار العرض ${quotationNumber} v${version}`,
      createdAt: nowIso(),
    });
  }
  event.updatedAt = nowIso();
  audit(s, actor, "quotation.issued", "quotation", quote.id, {
    quotationNumber,
    version,
    selling: totals.selling,
  });
  state = s;
  emit();
  return quote;
}

export function acceptEventQuotation(
  session: Session | null,
  quotationId: string,
): Quotation {
  const actor = requireActor(session);
  if (!canManageCommercialFor(actor.role)) throw new DomainError("UNAUTHORIZED");
  const s = cloneState(state);
  const quote = scoped(s.quotations, actor.organizationId).find(
    (q) => q.id === quotationId,
  );
  if (!quote) throw new DomainError("NOT_FOUND");
  const event = requireEvent(s, actor, quote.eventId);
  if (event.acceptedQuotationId === quote.id && quote.status === "ACCEPTED") {
    return quote;
  }
  if (event.acceptedQuotationId && event.acceptedQuotationId !== quote.id) {
    throw new DomainError("QUOTE_ALREADY_ACCEPTED");
  }
  if (quote.status !== "ISSUED") throw new DomainError("QUOTE_NOT_ISSUED");
  if (event.status !== "QUOTED") {
    throw new DomainError("INVALID_EVENT_TRANSITION");
  }
  quote.status = "ACCEPTED";
  event.acceptedQuotationId = quote.id;
  event.status = "CONFIRMED";
  event.updatedAt = nowIso();
  s.eventHistory.push({
    id: uid("eh"),
    organizationId: actor.organizationId,
    eventId: event.id,
    fromStatus: "QUOTED",
    toStatus: "CONFIRMED",
    actorId: actor.profileId,
    reason: `قبول ${quote.quotationNumber} v${quote.version}`,
    createdAt: nowIso(),
  });
  audit(s, actor, "quotation.accepted", "quotation", quote.id, {
    eventId: event.id,
  });
  state = s;
  emit();
  return quote;
}

export function rejectEventQuotation(
  session: Session | null,
  quotationId: string,
): Quotation {
  const actor = requireActor(session);
  if (!canManageCommercialFor(actor.role)) throw new DomainError("UNAUTHORIZED");
  const s = cloneState(state);
  const quote = scoped(s.quotations, actor.organizationId).find(
    (q) => q.id === quotationId,
  );
  if (!quote) throw new DomainError("NOT_FOUND");
  if (quote.status !== "ISSUED") throw new DomainError("QUOTE_IMMUTABLE");
  quote.status = "REJECTED";
  audit(s, actor, "quotation.rejected", "quotation", quote.id, {});
  state = s;
  emit();
  return quote;
}

/* -------------------------------------------------------------------------- */
/* Staff                                                                       */
/* -------------------------------------------------------------------------- */

export function upsertStaffMember(
  session: Session | null,
  input: {
    id?: string;
    name: string;
    phone: string;
    whatsapp?: string;
    staffType: StaffType;
    defaultCompensationMethod: CompensationMethod;
    defaultRateMilli: MilliOMR;
    notes?: string;
    isActive?: boolean;
  },
): StaffMember {
  const actor = requireActor(session);
  if (!canManageStaffDirectoryFor(actor.role)) throw new DomainError("UNAUTHORIZED");
  const s = cloneState(state);
  if (!input.name.trim()) throw new DomainError("VALIDATION", "اسم الموظف مطلوب");
  let member = input.id
    ? scoped(s.staffMembers, actor.organizationId).find((m) => m.id === input.id)
    : undefined;
  if (input.id && !member) throw new DomainError("NOT_FOUND");
  if (!member) {
    member = {
      id: uid("staff"),
      organizationId: actor.organizationId,
      name: input.name.trim(),
      phone: input.phone.trim(),
      whatsapp: (input.whatsapp ?? input.phone).trim(),
      staffType: input.staffType,
      isActive: input.isActive ?? true,
      defaultCompensationMethod: input.defaultCompensationMethod,
      defaultRateMilli: input.defaultRateMilli,
      notes: input.notes ?? "",
    };
    s.staffMembers.unshift(member);
    audit(s, actor, "staff.created", "staff", member.id, { name: member.name });
  } else {
    member.name = input.name.trim();
    member.phone = input.phone.trim();
    member.whatsapp = (input.whatsapp ?? member.whatsapp).trim();
    member.staffType = input.staffType;
    member.defaultCompensationMethod = input.defaultCompensationMethod;
    member.defaultRateMilli = input.defaultRateMilli;
    member.notes = input.notes ?? member.notes;
    if (input.isActive !== undefined) member.isActive = input.isActive;
    audit(s, actor, "staff.updated", "staff", member.id, {});
  }
  state = s;
  emit();
  return member;
}

export function assignEventStaff(
  session: Session | null,
  input: {
    eventId: string;
    staffMemberId: string;
    assignmentRole?: StaffType;
    scheduledStart?: string;
    scheduledEnd?: string;
    arrivalAt?: string | null;
    bufferBeforeMinutes?: number;
    bufferAfterMinutes?: number;
    compensationMethod?: CompensationMethod;
    rateMilli?: MilliOMR;
    notes?: string;
  },
) {
  const actor = requireActor(session);
  if (!canAssignStaffFor(actor.role)) throw new DomainError("UNAUTHORIZED");
  const s = cloneState(state);
  const event = requireEvent(s, actor, input.eventId);
  if (event.status === "CLOSED") throw new DomainError("EVENT_CLOSED");
  if (event.status === "CANCELLED") throw new DomainError("EVENT_CANCELLED");
  const staff = scoped(s.staffMembers, actor.organizationId).find(
    (m) => m.id === input.staffMemberId,
  );
  if (!staff) throw new DomainError("CROSS_ORG", "الموظف لا ينتمي لهذه المنظمة");
  if (!staff.isActive) throw new DomainError("INACTIVE_STAFF");

  const start = input.scheduledStart ?? event.teamArrivalAt ?? event.startAt;
  const end = input.scheduledEnd ?? event.endAt;
  if (new Date(end).getTime() <= new Date(start).getTime()) {
    throw new DomainError("INVALID_TIME");
  }
  const bufferBefore = input.bufferBeforeMinutes ?? 0;
  const bufferAfter = input.bufferAfterMinutes ?? 0;
  const windowStart = shiftMinutes(start, -bufferBefore);
  const windowEnd = shiftMinutes(end, bufferAfter);

  const avail = getStaffAvailability(
    s,
    actor,
    staff.id,
    windowStart,
    windowEnd,
  );
  if (!avail.available) {
    throw new DomainError(
      "STAFF_CONFLICT",
      avail.reason ?? "الموظف مرتبط بمناسبة أخرى في هذا الوقت",
      {
        conflictingEventNumber: avail.conflictingEventNumber,
        from: avail.conflictingFrom,
        until: avail.conflictingUntil,
      },
    );
  }

  const method = input.compensationMethod ?? staff.defaultCompensationMethod;
  const rate = input.rateMilli ?? staff.defaultRateMilli;
  const expected = calculateCompensation(method, rate, start, end);
  const assignment = {
    id: uid("asg"),
    organizationId: actor.organizationId,
    eventId: event.id,
    staffMemberId: staff.id,
    assignmentRole: input.assignmentRole ?? staff.staffType,
    scheduledStart: start,
    scheduledEnd: end,
    arrivalAt: input.arrivalAt ?? event.teamArrivalAt,
    bufferBeforeMinutes: bufferBefore,
    bufferAfterMinutes: bufferAfter,
    compensationMethod: method,
    rateMilli: rate,
    expectedCompensationMilli: expected,
    status: "ASSIGNED" as const,
    notes: input.notes ?? "",
  };
  s.staffAssignments.push(assignment);
  audit(s, actor, "staff.assigned", "event", event.id, {
    staffId: staff.id,
    name: staff.name,
  });
  state = s;
  emit();
  return assignment;
}

export function releaseStaffAssignment(session: Session | null, assignmentId: string) {
  const actor = requireActor(session);
  if (!canAssignStaffFor(actor.role)) throw new DomainError("UNAUTHORIZED");
  const s = cloneState(state);
  const asg = s.staffAssignments.find((a) => a.id === assignmentId);
  if (!asg || asg.organizationId !== actor.organizationId) {
    throw new DomainError("NOT_FOUND");
  }
  asg.status = "RELEASED";
  audit(s, actor, "staff.released", "event", asg.eventId, { assignmentId });
  state = s;
  emit();
}

/* -------------------------------------------------------------------------- */
/* Equipment                                                                   */
/* -------------------------------------------------------------------------- */

export function upsertEquipmentStock(
  session: Session | null,
  input: {
    catalogItemId: string;
    totalQuantity: number;
    isActive?: boolean;
  },
) {
  const actor = requireActor(session);
  if (!canManageEquipmentCapacityFor(actor.role)) {
    throw new DomainError("UNAUTHORIZED");
  }
  const s = cloneState(state);
  const item = scoped(s.catalogItems, actor.organizationId).find(
    (i) => i.id === input.catalogItemId,
  );
  if (!item) throw new DomainError("CROSS_ORG");
  if (item.itemType !== "REUSABLE_EQUIPMENT") {
    throw new DomainError("VALIDATION", "الحجز للمعدات القابلة لإعادة الاستخدام فقط");
  }
  if (!Number.isInteger(input.totalQuantity) || input.totalQuantity < 0) {
    throw new DomainError("INVALID_QUANTITY");
  }
  let stock = s.equipmentStock.find(
    (e) =>
      e.organizationId === actor.organizationId &&
      e.catalogItemId === input.catalogItemId,
  );
  if (!stock) {
    stock = {
      id: uid("eq"),
      organizationId: actor.organizationId,
      catalogItemId: input.catalogItemId,
      totalQuantity: input.totalQuantity,
      isActive: input.isActive ?? true,
    };
    s.equipmentStock.push(stock);
  } else {
    stock.totalQuantity = input.totalQuantity;
    if (input.isActive !== undefined) stock.isActive = input.isActive;
  }
  audit(s, actor, "equipment.capacity", "equipment", stock.id, {
    catalogItemId: input.catalogItemId,
    total: input.totalQuantity,
  });
  state = s;
  emit();
  return stock;
}

export function reserveEventEquipment(
  session: Session | null,
  input: {
    eventId: string;
    catalogItemId: string;
    quantity: number;
    reservedFrom?: string;
    reservedUntil?: string;
  },
) {
  const actor = requireActor(session);
  if (!canReserveEquipmentFor(actor.role)) throw new DomainError("UNAUTHORIZED");
  const s = cloneState(state);
  const event = requireEvent(s, actor, input.eventId);
  if (event.status === "CLOSED") throw new DomainError("EVENT_CLOSED");
  if (event.status === "CANCELLED") throw new DomainError("EVENT_CANCELLED");
  if (!Number.isInteger(input.quantity) || input.quantity <= 0) {
    throw new DomainError("INVALID_QUANTITY");
  }
  const item = scoped(s.catalogItems, actor.organizationId).find(
    (i) => i.id === input.catalogItemId,
  );
  if (!item) throw new DomainError("CROSS_ORG");
  if (item.itemType !== "REUSABLE_EQUIPMENT") {
    throw new DomainError("VALIDATION", "الحجز للمعدات القابلة لإعادة الاستخدام فقط");
  }
  const stock = s.equipmentStock.find(
    (e) =>
      e.organizationId === actor.organizationId &&
      e.catalogItemId === input.catalogItemId,
  );
  if (!stock || !stock.isActive) throw new DomainError("INACTIVE_EQUIPMENT");

  const from = input.reservedFrom ?? shiftMinutes(event.startAt, -60);
  const until = input.reservedUntil ?? shiftMinutes(event.endAt, 60);
  if (new Date(until).getTime() <= new Date(from).getTime()) {
    throw new DomainError("INVALID_TIME");
  }

  const avail = getEquipmentAvailability(
    s,
    actor,
    input.catalogItemId,
    from,
    until,
    input.quantity,
  );
  if (avail.shortage > 0) {
    throw new DomainError(
      "EQUIPMENT_SHORTAGE",
      `الكمية المتاحة ${avail.available} والمطلوب ${input.quantity}`,
      {
        available: avail.available,
        requested: input.quantity,
        shortage: avail.shortage,
        total: avail.totalQuantity,
        reserved: avail.alreadyReserved,
      },
    );
  }

  const existing = s.equipmentReservations.find(
    (r) =>
      r.eventId === event.id &&
      r.catalogItemId === input.catalogItemId &&
      r.status === "ACTIVE",
  );
  if (existing) {
    const availUpdate = getEquipmentAvailability(
      s,
      actor,
      input.catalogItemId,
      from,
      until,
      input.quantity,
      existing.id,
    );
    if (availUpdate.shortage > 0) {
      throw new DomainError(
        "EQUIPMENT_SHORTAGE",
        `الكمية المتاحة ${availUpdate.available} والمطلوب ${input.quantity}`,
        {
          available: availUpdate.available,
          requested: input.quantity,
          shortage: availUpdate.shortage,
        },
      );
    }
    existing.quantity = input.quantity;
    existing.reservedFrom = from;
    existing.reservedUntil = until;
    audit(s, actor, "equipment.reserved", "event", event.id, {
      catalogItemId: input.catalogItemId,
      quantity: input.quantity,
      updated: true,
    });
    state = s;
    emit();
    return existing;
  }

  const reservation = {
    id: uid("res"),
    organizationId: actor.organizationId,
    eventId: event.id,
    catalogItemId: input.catalogItemId,
    quantity: input.quantity,
    reservedFrom: from,
    reservedUntil: until,
    status: "ACTIVE" as const,
    createdBy: actor.profileId,
    createdAt: nowIso(),
  };
  s.equipmentReservations.push(reservation);
  audit(s, actor, "equipment.reserved", "event", event.id, {
    catalogItemId: input.catalogItemId,
    quantity: input.quantity,
  });
  state = s;
  emit();
  return reservation;
}

export function releaseEquipmentReservation(
  session: Session | null,
  reservationId: string,
) {
  const actor = requireActor(session);
  if (!canReserveEquipmentFor(actor.role)) throw new DomainError("UNAUTHORIZED");
  const s = cloneState(state);
  const res = s.equipmentReservations.find((r) => r.id === reservationId);
  if (!res || res.organizationId !== actor.organizationId) {
    throw new DomainError("NOT_FOUND");
  }
  res.status = "RELEASED";
  audit(s, actor, "equipment.released", "event", res.eventId, { reservationId });
  state = s;
  emit();
}

export function stripCostFromQuote(quote: Quotation, role: AppRole): Quotation {
  if (canReadCostFor(role)) return quote;
  return {
    ...quote,
    expectedCostTotalMilli: 0,
    expectedProfitMilli: 0,
  };
}
