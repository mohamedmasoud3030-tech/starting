import { useMemo, useState, type ReactNode } from "react";
import { Link, useNavigate, useParams } from "react-router-dom";
import {
  AlertTriangle,
  CheckCircle2,
  ExternalLink,
  MapPin,
  Users,
} from "lucide-react";
import { useSession } from "@/app/session";
import {
  acceptEventQuotation,
  addCatalogLineToEvent,
  addCustomLineToEvent,
  applyPackageToEvent,
  assignEventStaff,
  cancelEvent,
  eventTotals,
  getEquipmentAvailability,
  getEventReadiness,
  getStaffAvailability,
  issueEventQuotation,
  releaseEquipmentReservation,
  releaseStaffAssignment,
  removePricingLine,
  reserveEventEquipment,
  toCustomerQuoteView,
  transitionEventStatus,
  updatePricingLine,
  useEngine,
} from "@/engine/engine";
import {
  EVENT_STATUS_LABELS,
  EVENT_TYPE_LABELS,
  ITEM_TYPE_LABELS,
  PRICING_METHOD_HELP,
  PRICING_METHOD_LABELS,
  READINESS_LABELS,
  STAFF_TYPE_LABELS,
  canAssignStaffFor,
  canCancelEventsFor,
  canManageCommercialFor,
  canReadCostFor,
  canReserveEquipmentFor,
  canWriteEventsFor,
  nextOperationalStatus,
  type PricingMethod,
} from "@/lib/domain";
import { errorMessage } from "@/lib/errors";
import { formatOMR, parseQuantityMilli, toOMRString } from "@/lib/money";
import {
  formatMuscatDateTime,
  formatMuscatRange,
  formatMuscatTime,
  shiftMinutes,
} from "@/lib/time";
import { MoneyInput } from "@/components/MoneyInput";
import { EventStatusBadge, QuoteStatusBadge } from "@/components/StatusBadge";
import {
  Alert,
  Badge,
  Button,
  Card,
  CardBody,
  Dialog,
  Field,
  Input,
  Select,
  Textarea,
} from "@/components/ui";
import { cn } from "@/lib/utils";

type Tab = "summary" | "pricing" | "team" | "equipment" | "history";

export function EventWorkspace() {
  const { eventId } = useParams();
  const { session } = useSession();
  const state = useEngine();
  const [tab, setTab] = useState<Tab>("summary");

  const event = state.events.find(
    (e) => e.id === eventId && e.organizationId === session!.organizationId,
  );
  if (!event) {
    return (
      <Alert>
        المناسبة غير موجودة.{" "}
        <Link to="/events" className="underline">
          العودة للقائمة
        </Link>
      </Alert>
    );
  }

  const customer = state.customers.find((c) => c.id === event.customerId);
  const readiness = getEventReadiness(state, session!, event.id);
  const tabs: Array<{ id: Tab; label: string }> = [
    { id: "summary", label: "ملخص" },
    { id: "pricing", label: "التسعير" },
    { id: "team", label: "الفريق" },
    { id: "equipment", label: "المعدات" },
    { id: "history", label: "السجل" },
  ];

  return (
    <div>
      <div className="mb-4 flex flex-wrap items-start justify-between gap-3">
        <div>
          <p className="text-sm font-extrabold tracking-wide text-brand-700">
            {event.eventNumber}
          </p>
          <h1 className="text-2xl font-extrabold sm:text-3xl">{event.title}</h1>
          <p className="mt-1 text-slate-500">{customer?.name}</p>
        </div>
        <EventStatusBadge status={event.status} />
      </div>

      <ReadinessBanner state={readiness.state} issues={readiness.issues} />

      <div className="no-print mb-5 flex gap-2 overflow-x-auto pb-1">
        {tabs.map((t) => (
          <button
            key={t.id}
            onClick={() => setTab(t.id)}
            className={cn(
              "min-h-12 shrink-0 rounded-xl px-4 text-base font-bold",
              tab === t.id
                ? "bg-brand-700 text-white"
                : "bg-white text-slate-700 ring-1 ring-slate-200",
            )}
          >
            {t.label}
          </button>
        ))}
      </div>

      {tab === "summary" && <SummaryTab eventId={event.id} />}
      {tab === "pricing" && <PricingTab eventId={event.id} />}
      {tab === "team" && <TeamTab eventId={event.id} />}
      {tab === "equipment" && <EquipmentTab eventId={event.id} />}
      {tab === "history" && <HistoryTab eventId={event.id} />}
    </div>
  );
}

function ReadinessBanner({
  state,
  issues,
}: {
  state: ReturnType<typeof getEventReadiness>["state"];
  issues: ReturnType<typeof getEventReadiness>["issues"];
}) {
  const ready = state === "READY";
  return (
    <div
      className={cn(
        "mb-5 rounded-2xl px-5 py-4",
        ready ? "bg-emerald-50 text-emerald-900" : "bg-amber-50 text-amber-950",
      )}
    >
      <div className="flex items-start gap-3">
        {ready ? (
          <CheckCircle2 className="mt-0.5 h-7 w-7 shrink-0" />
        ) : (
          <AlertTriangle className="mt-0.5 h-7 w-7 shrink-0" />
        )}
        <div>
          <p className="text-xl font-extrabold">{READINESS_LABELS[state]}</p>
          {issues.length > 0 ? (
            <ul className="mt-1 list-disc pr-5 text-base font-bold">
              {issues.map((i, idx) => (
                <li key={idx}>{i.message}</li>
              ))}
            </ul>
          ) : (
            <p className="text-sm">التسعير والفريق والمعدات جاهزة.</p>
          )}
        </div>
      </div>
    </div>
  );
}

function SummaryTab({ eventId }: { eventId: string }) {
  const { session } = useSession();
  const state = useEngine();
  const navigate = useNavigate();
  const event = state.events.find((e) => e.id === eventId)!;
  const customer = state.customers.find((c) => c.id === event.customerId);
  const canWrite = canWriteEventsFor(session!.role);
  const canCancel = canCancelEventsFor(session!.role);
  const next = nextOperationalStatus(event.status);
  const [cancelOpen, setCancelOpen] = useState(false);
  const [reason, setReason] = useState("");
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);

  return (
    <div className="space-y-4">
      {error ? <Alert>{error}</Alert> : null}
      <Card>
        <CardBody className="space-y-4">
          <div className="grid gap-4 sm:grid-cols-2">
            <Info label="رقم المناسبة" value={event.eventNumber} />
            <Info label="الحالة" value={EVENT_STATUS_LABELS[event.status]} />
            <Info label="العميل" value={customer?.name ?? "—"} />
            <Info label="النوع" value={EVENT_TYPE_LABELS[event.eventType]} />
            <Info
              label="الوقت"
              value={formatMuscatRange(event.startAt, event.endAt)}
            />
            <Info
              label="الضيوف"
              value={`${event.guestCount}`}
              icon={<Users className="h-4 w-4" />}
            />
            <Info
              label="الموقع"
              value={event.venueName}
              icon={<MapPin className="h-4 w-4" />}
            />
            <Info label="العنوان" value={event.address || "—"} />
          </div>
          {event.mapUrl ? (
            <a
              href={event.mapUrl}
              target="_blank"
              rel="noreferrer"
              className="inline-flex min-h-12 items-center gap-2 font-bold text-brand-800"
            >
              فتح الخريطة <ExternalLink className="h-4 w-4" />
            </a>
          ) : null}
          {event.notes ? (
            <p className="rounded-xl bg-sand-100 p-4 text-slate-700">{event.notes}</p>
          ) : null}
          {event.cancellationReason ? (
            <Alert>سبب الإلغاء: {event.cancellationReason}</Alert>
          ) : null}
        </CardBody>
      </Card>

      {canWrite && next ? (
        <Button
          size="lg"
          className="w-full sm:w-auto"
          loading={busy}
          onClick={() => {
            setBusy(true);
            setError("");
            try {
              transitionEventStatus(session, event.id, next);
            } catch (e) {
              setError(errorMessage(e));
            } finally {
              setBusy(false);
            }
          }}
        >
          نقل إلى: {EVENT_STATUS_LABELS[next]}
        </Button>
      ) : null}

      {canCancel &&
      ["DRAFT", "QUOTED", "CONFIRMED", "PREPARING"].includes(event.status) ? (
        <Button variant="danger" onClick={() => setCancelOpen(true)}>
          إلغاء المناسبة
        </Button>
      ) : null}

      <Dialog
        open={cancelOpen}
        onOpenChange={setCancelOpen}
        title="تأكيد إلغاء المناسبة"
        description="سيُفرج عن المعدات ويُلغى إسناد الفريق."
      >
        <div className="space-y-4">
          <Field label="سبب الإلغاء">
            <Textarea value={reason} onChange={(e) => setReason(e.target.value)} />
          </Field>
          <Button
            variant="danger"
            className="w-full"
            onClick={() => {
              try {
                cancelEvent(session, event.id, reason);
                setCancelOpen(false);
                navigate("/events");
              } catch (e) {
                setError(errorMessage(e));
              }
            }}
          >
            تأكيد الإلغاء
          </Button>
        </div>
      </Dialog>
    </div>
  );
}

function Info({
  label,
  value,
  icon,
}: {
  label: string;
  value: string;
  icon?: ReactNode;
}) {
  return (
    <div>
      <p className="text-sm font-bold text-slate-500">{label}</p>
      <p className="mt-0.5 flex items-center gap-1 text-lg font-extrabold">
        {icon}
        {value}
      </p>
    </div>
  );
}

function PricingTab({ eventId }: { eventId: string }) {
  const { session } = useSession();
  const state = useEngine();
  const event = state.events.find((e) => e.id === eventId)!;
  const canWrite = canManageCommercialFor(session!.role);
  const canCost = canReadCostFor(session!.role);
  const lines = state.pricingLines
    .filter((l) => l.eventId === eventId)
    .sort((a, b) => a.sortOrder - b.sortOrder);
  const quotes = state.quotations
    .filter((q) => q.eventId === eventId)
    .sort((a, b) => b.version - a.version);
  const packages = state.packages.filter(
    (p) => p.organizationId === session!.organizationId && p.status === "ACTIVE",
  );
  const catalog = state.catalogItems.filter(
    (i) => i.organizationId === session!.organizationId && i.status === "ACTIVE",
  );
  const totals = eventTotals(state, eventId);
  const [pkgId, setPkgId] = useState(packages[0]?.id ?? "");
  const [catalogId, setCatalogId] = useState(catalog[0]?.id ?? "");
  const [error, setError] = useState("");
  const [busy, setBusy] = useState("");
  const [customOpen, setCustomOpen] = useState(false);
  const [previewId, setPreviewId] = useState<string | null>(null);
  const [custom, setCustom] = useState({
    description: "",
    pricingMethod: "MANUAL" as PricingMethod,
    qty: "1",
