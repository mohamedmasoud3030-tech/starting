+  const [reference, setReference] = useState("");
+  const [reason, setReason] = useState("");
+
+  const rows = payroll.data ?? [];
+
+  const assignedHostOptions = useMemo(
+    () => rows.map((r) => ({ id: r.staffMemberId, name: r.staffName })),
+    [rows],
