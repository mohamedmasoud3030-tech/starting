{
  "name": "hospitality-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Arabic-first hospitality operations platform for event-service businesses in the Sultanate of Oman.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke:production": "node scripts/production_smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:reset": "supabase db reset",
    "db:backup-restore-proof": "node scripts/native-db/backup_restore_proof.mjs",
    "audit:check": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.95.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "oxlint": "^1.0.0",
    "pg": "^8.23.0",
    "prettier": "3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18 <25",
    "npm": ">=10"
  }
}
