# Supabase Project Configuration
# These are the ONLY client-side (public) credentials the app needs.
# Copy this file to `.env` and fill in values from your Supabase project
# dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Feature flags (optional)
# Set to false to hide the AI assistant "Lena" when GEMINI_API_KEY is not configured
# VITE_ENABLE_ASSISTANT=true

# Storage: attachments bucket is created by migration 0074 and requires
# supabase/config.toml [storage] enabled=true for local development
