# Supabase Project Configuration
# These are the ONLY client-side (public) credentials the app needs.
# Copy this file to `.env` and fill in values from your Supabase project
# dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# TEMPORARY public demo mode — per-deployment opt-in ONLY.
# Default (unset or anything but the exact string "true") = normal Supabase
# Auth flow. Setting this to "true" bypasses login and grants anonymous
# visitors OWNER-equivalent capability, RLS-scoped to the single named demo
# organization. Must never be set on real production deployments.
# VITE_PUBLIC_DEMO_MODE=true
