# Supabase Project Configuration
# These are the ONLY client-side (public) credentials the app needs.
# Copy this file to `.env` and fill in values from your Supabase project
# dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Feature flags (optional)
# VITE_ENABLE_ASSISTANT gates the floating assistant «لينا». Unset or empty means
# ENABLED (the shipped default). Set it to false for a demo build so the
# launcher never renders — recommended until the assistant is part of the script,
# since its replies are generated server-side and may come back degraded.
# VITE_ENABLE_ASSISTANT=false

# Storage: attachments bucket is created by migration 0074 and requires
# supabase/config.toml [storage] enabled=true for local development
